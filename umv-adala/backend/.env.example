# 5001, not 5000 — macOS's AirPlay Receiver squats on 5000 and will
# silently swallow requests before they reach this server.
PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?appName=<app-name>
JWT_SECRET=replace_with_a_long_random_string

# ── Google Drive (notice attachments) ────────────────────────────────────────
# Personal Gmail: OAuth is required (service accounts cannot upload to My Drive).
# 1. Google Cloud Console → enable Drive API → create OAuth 2.0 Client ID (Desktop)
# 2. Set GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET below
# 3. Run: node scripts/get-oauth-token.js → paste GOOGLE_OAUTH_REFRESH_TOKEN here
# 4. Create a folder in your Drive; copy its ID from the URL:
#    https://drive.google.com/drive/folders/<DRIVE_FOLDER_ID>
DRIVE_FOLDER_ID=your_google_drive_folder_id
# Optional: separate gallery folder. If unset, uses DRIVE_FOLDER_ID.
# Run: npm run setup-gallery-folder  (creates "UMV Adala Gallery" subfolder)
# DRIVE_GALLERY_FOLDER_ID=your_gallery_folder_id
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3333/oauth2callback

# SMTP (For email OTP)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Twilio (For SMS OTP)
TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone
